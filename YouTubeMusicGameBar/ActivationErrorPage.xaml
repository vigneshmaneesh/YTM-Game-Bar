<Page
    x:Class="YouTubeMusicGameBar.ActivationErrorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#171717">
    <Grid Padding="32">
        <StackPanel
            MaxWidth="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <FontIcon
                HorizontalAlignment="Center"
                FontFamily="Segoe MDL2 Assets"
                FontSize="32"
                Foreground="#FF5C5C"
                Glyph="&#xE783;" />
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="White"
                Text="YouTube Music widget error"
                TextAlignment="Center" />
            <TextBlock
                x:Name="MessageTextBlock"
                Foreground="#D0D0D0"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
