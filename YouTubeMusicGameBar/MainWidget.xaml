<Page
    x:Class="YouTubeMusicGameBar.MainWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="#111111"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="#111111">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ToolbarRow" Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="Toolbar"
            Grid.Row="0"
            Background="#202020"
            BorderBrush="#333333"
            BorderThickness="0,0,0,1">
            <Grid Padding="3,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="BackButton"
                    Grid.Column="0"
                    AutomationProperties.Name="Back"
                    Click="BackButton_Click"
                    IsEnabled="False"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="Back">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72B;" />
                </Button>
                <Button
                    x:Name="ForwardButton"
                    Grid.Column="1"
                    AutomationProperties.Name="Forward"
                    Click="ForwardButton_Click"
                    IsEnabled="False"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="Forward">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72A;" />
                </Button>
                <Button
                    x:Name="RefreshButton"
                    Grid.Column="2"
                    AutomationProperties.Name="Refresh"
                    Click="RefreshButton_Click"
                    IsEnabled="False"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="Refresh">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" />
                </Button>
                <Button
                    x:Name="HomeButton"
                    Grid.Column="3"
                    AutomationProperties.Name="YouTube Music home"
                    Click="HomeButton_Click"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="YouTube Music home">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE80F;" />
                </Button>

                <TextBlock
                    Grid.Column="4"
                    Margin="10,0,4,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#CCCCCC"
                    Text="YouTube Music"
                    TextTrimming="CharacterEllipsis" />

                <ProgressRing
                    x:Name="ToolbarProgressRing"
                    Grid.Column="5"
                    Width="18"
                    Height="18"
                    Margin="4,0"
                    IsActive="False"
                    Visibility="Collapsed" />

                <Button
                    x:Name="SizeButton"
                    Grid.Column="6"
                    Width="48"
                    AutomationProperties.Name="Resize widget"
                    Content="Size"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="Resize widget">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Click="SizeMenuItem_Click" Tag="phone" Text="Phone portrait (464 × 1000)" />
                            <MenuFlyoutItem Click="SizeMenuItem_Click" Tag="portrait" Text="Portrait (600 × 900)" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="SizeMenuItem_Click" Tag="square" Text="Square (900 × 900)" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button
                    Grid.Column="7"
                    x:Name="UserAgentButton"
                    Width="42"
                    AutomationProperties.Name="Choose user agent"
                    Content="UA"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="Choose mobile or desktop layout">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <ToggleMenuFlyoutItem
                                x:Name="MobileUserAgentMenuItem"
                                Click="UserAgentMenuItem_Click"
                                Tag="mobile"
                                Text="Mobile layout" />
                            <ToggleMenuFlyoutItem
                                x:Name="DesktopUserAgentMenuItem"
                                Click="UserAgentMenuItem_Click"
                                Tag="desktop"
                                Text="Desktop layout" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button
                    Grid.Column="8"
                    x:Name="ZoomButton"
                    Width="48"
                    AutomationProperties.Name="Page zoom"
                    Content="100%"
                    IsEnabled="False"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="Zoom webpage">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button
                                    x:Name="ZoomOutButton"
                                    Width="36"
                                    Height="32"
                                    Padding="0"
                                    AutomationProperties.Name="Zoom out"
                                    Click="ZoomOutButton_Click"
                                    Content="&#x2212;"
                                    FontSize="18"
                                    ToolTipService.ToolTip="Zoom out" />
                                <Button
                                    x:Name="ZoomResetButton"
                                    Width="58"
                                    Height="32"
                                    Padding="0"
                                    AutomationProperties.Name="Reset zoom"
                                    Click="ZoomResetButton_Click"
                                    Content="100%"
                                    ToolTipService.ToolTip="Reset zoom to 100%" />
                                <Button
                                    x:Name="ZoomInButton"
                                    Width="36"
                                    Height="32"
                                    Padding="0"
                                    AutomationProperties.Name="Zoom in"
                                    Click="ZoomInButton_Click"
                                    Content="+"
                                    FontSize="18"
                                    ToolTipService.ToolTip="Zoom in" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button
                    Grid.Column="9"
                    AutomationProperties.Name="Hide toolbar"
                    Click="HideToolbarButton_Click"
                    Style="{StaticResource ToolbarButtonStyle}"
                    ToolTipService.ToolTip="Hide toolbar">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE70E;" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <muxc:WebView2
                x:Name="MusicWebView"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                CoreProcessFailed="MusicWebView_CoreProcessFailed"
                CoreWebView2Initialized="MusicWebView_CoreWebView2Initialized"
                NavigationCompleted="MusicWebView_NavigationCompleted"
                NavigationStarting="MusicWebView_NavigationStarting" />

            <Grid
                x:Name="LoadingOverlay"
                Background="#111111"
                Visibility="Visible">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <ProgressRing
                        Width="32"
                        Height="32"
                        IsActive="True" />
                    <TextBlock
                        Foreground="#D8D8D8"
                        Text="Starting YouTube Music…" />
                </StackPanel>
            </Grid>

            <Grid
                x:Name="ErrorOverlay"
                Padding="32"
                Background="#171717"
                Visibility="Collapsed">
                <StackPanel
                    MaxWidth="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="30"
                        Foreground="#FF5C5C"
                        Glyph="&#xE783;" />
                    <TextBlock
                        x:Name="ErrorTitle"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="YouTube Music could not be loaded"
                        TextAlignment="Center" />
                    <TextBlock
                        x:Name="ErrorMessage"
                        Foreground="#D0D0D0"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        HorizontalAlignment="Center"
                        Click="RetryButton_Click"
                        Content="Try again" />
                </StackPanel>
            </Grid>

            <Button
                x:Name="ShowToolbarButton"
                Width="30"
                Height="26"
                Margin="4"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                AutomationProperties.Name="Show toolbar"
                Background="#CC202020"
                BorderThickness="0"
                Click="ShowToolbarButton_Click"
                ToolTipService.ToolTip="Show toolbar"
                Visibility="Collapsed">
                <FontIcon FontFamily="Segoe MDL2 Assets" FontSize="12" Glyph="&#xE70D;" />
            </Button>
        </Grid>
    </Grid>
</Page>
